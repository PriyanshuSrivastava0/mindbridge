# ==============================================================================
# MINDBRIDGE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindbridge?schema=public

# Redis & Background Workers (BullMQ)
REDIS_URL=redis://localhost:6379

# Cryptography & Session Tokens (Never commit secrets to VCS)
JWT_SECRET=super_secret_session_encryption_key_minimum_32_characters
DATA_ENCRYPTION_KEY=32_byte_aes_gcm_hex_key_for_encrypting_clinical_and_journal_notes

# LLM & AI Service Providers (Provider-agnostic adapter)
# Supported: openai, anthropic, gemini, or mock local sandbox
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telehealth Video Infrastructure (WebRTC / Daily.co / Jitsi Meet)
DAILY_API_KEY=your_daily_co_api_key_optional

# Payment Gateway (Razorpay for India / Stripe for International)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
STRIPE_SECRET_KEY=sk_test_placeholder_secret
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Emergency SMS & WhatsApp Delivery Adapters (Twilio / Gupshup)
TWILIO_ACCOUNT_SID=AC_test_account_sid_placeholder
TWILIO_AUTH_TOKEN=test_auth_token_placeholder
TWILIO_PHONE_NUMBER=+1234567890

# S3-Compatible Private File Storage (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=mindbridge-private-clinical-records
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key

# University Safety & Tele-MANAS Hotline Integration
NATIONAL_CRISIS_HOTLINE_INDIA=14416
NATIONAL_CRISIS_HOTLINE_US=988

